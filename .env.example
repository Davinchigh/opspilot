# Copy to .env. Leave OPSPILOT_PROVIDER=offline to run with no account.
OPSPILOT_PROVIDER=offline

# To use a real model, set provider to "openai" and fill in any OpenAI-compatible service.
# Check each provider's own docs for the current base URL, model names, free limits and prices.
#   Google Gemini: https://ai.google.dev/gemini-api/docs/openai
#   Groq:          https://console.groq.com/docs/openai
#   OpenRouter:    https://openrouter.ai/docs
#   Ollama (local): https://docs.ollama.com/openai
# Gemini example base URL (checked 2026-11-26): https://generativelanguage.googleapis.com/v1beta/openai/
# Create a key at https://aistudio.google.com/apikey and copy a current model name from Google's model list.
OPSPILOT_BASE_URL=
OPSPILOT_API_KEY=
OPSPILOT_MODEL=
# USD per 1 million tokens, used for the cost figures
OPSPILOT_PRICE_IN=0
OPSPILOT_PRICE_OUT=0

# Required if the server listens on anything other than localhost
OPSPILOT_TOKEN=
